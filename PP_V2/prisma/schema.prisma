generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  username     String          @unique
  phone        String          @default("")
  passwordHash String
  role         String          @default("USER")
  endedAt      DateTime?
  createdAt    DateTime        @default(now())
  participations Participation[]
  answers      Answer[]
  results      Result[]
  activityLogs ActivityLog[]
  suspiciousFlags SuspiciousFlag[]
}

model Game {
  id             String          @id @default(cuid())
  categoria      String
  costo          Float           @default(0)
  maxPlayers     Int             @default(10)
  maxWinners     Int             @default(3)
  status         String          @default("waiting")
  startTimestamp DateTime?
  endedAt      DateTime?
  createdAt      DateTime        @default(now())
  participations Participation[]
  gameQuestions  GameQuestion[]
  answers        Answer[]
  results        Result[]
  activityLogs   ActivityLog[]
  suspiciousFlags SuspiciousFlag[]
}

model Question {
  id               String         @id @default(cuid())
  texto            String
  opciones         Json
  respuestaCorrecta Int
  dificultad       String         @default("medium")
  tipo             String         @default("multiple")
  categoria        String         @default("general")
  createdAt        DateTime       @default(now())
  gameQuestions    GameQuestion[]
  answers          Answer[]
}

model GameQuestion {
  id         String   @id @default(cuid())
  gameId     String
  questionId String
  orden      Int
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([gameId, questionId])
  @@unique([gameId, orden])
}

model Participation {
  id             String   @id @default(cuid())
  userId         String
  gameId         String
  estadoPago     String   @default("pending")
  esInvitado     Boolean  @default(false)
  fingerprintId  String?
  ipAddress      String?
  timestampInicio DateTime?
  timestampFin   DateTime?
  eliminado      Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game           Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  @@unique([userId, gameId])
}

model Answer {
  id              String   @id @default(cuid())
  userId          String
  gameId          String
  questionId      String
  respuesta       Int
  correcta        Boolean
  tiempoRespuesta Int
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([userId, gameId, questionId])
}

model Result {
  id          String @id @default(cuid())
  userId      String
  gameId      String
  puntaje     Int
  tiempoTotal Int
  posicion    Int
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  @@unique([userId, gameId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  gameId    String?
  action    String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
}

model SuspiciousFlag {
  id        String   @id @default(cuid())
  userId    String
  gameId    String?
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
}
