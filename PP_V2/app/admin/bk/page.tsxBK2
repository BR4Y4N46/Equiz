"use client";
import React, { useState, useEffect } from 'react';
import { useAuth } from '@/lib/auth-context';
import { useRouter } from 'next/navigation';
import Navbar from '@/components/navbar';
import { Plus, Gamepad2, Tag, Users, DollarSign, Trophy, Eye, Trash2, BookOpen } from 'lucide-react';
import { motion } from 'framer-motion';
import Link from 'next/link';

export default function AdminPage() {
  const { user, loading } = useAuth();
  const router = useRouter();
  const [games, setGames] = useState<any[]>([]);
  const [showCreate, setShowCreate] = useState(false);
  const [form, setForm] = useState({ categoria: '', costo: '0', maxPlayers: '10', maxWinners: '3' });
  const [creating, setCreating] = useState(false);
  const [error, setError] = useState('');

  useEffect(() => {
    if (!loading && (!user || user?.role !== 'ADMIN')) router.replace('/');
  }, [user, loading, router]);

  useEffect(() => {
    fetchGames();
    const interval = setInterval(fetchGames, 5000);
    return () => clearInterval(interval);
  }, []);

  const fetchGames = async () => {
    try {
      const res = await fetch('/api/games');
      const data = await res?.json?.();
      setGames(data?.games ?? []);
    } catch {}
  };

  const createGame = async (e: React.FormEvent) => {
    e?.preventDefault?.();
    setCreating(true);
    setError('');
    try {
      const res = await fetch('/api/games', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(form),
      });
      const data = await res?.json?.();
      if (res?.ok) {
        setShowCreate(false);
        setForm({ categoria: '', costo: '0', maxPlayers: '10', maxWinners: '3' });
        fetchGames();
      } else {
        setError(data?.error ?? 'Error');
      }
    } catch { setError('Error de conexión'); }
    setCreating(false);
  };

  const deleteGame = async (id: string) => {
    if (!confirm('¿Eliminar este juego?')) return;
    try {
      await fetch(`/api/games/${id}`, { method: 'DELETE' });
      fetchGames();
    } catch {}
  };

  const statusLabel = (s: string) => {
    const map: Record<string, { label: string; color: string }> = {
      waiting: { label: 'Esperando', color: 'bg-yellow-500/10 text-yellow-500' },
      countdown: { label: 'Cuenta regresiva', color: 'bg-orange-500/10 text-orange-500' },
      in_progress: { label: 'En progreso', color: 'bg-green-500/10 text-green-500' },
      finished: { label: 'Finalizado', color: 'bg-muted text-muted-foreground' },
    };
    return map?.[s] ?? { label: s, color: 'bg-muted text-muted-foreground' };
  };

  if (loading) return <div className="min-h-screen flex items-center justify-center"><div className="animate-spin w-8 h-8 border-2 border-primary border-t-transparent rounded-full" /></div>;

  return (
    <div className="min-h-screen bg-gradient-to-br from-background via-background to-primary/5">
      <Navbar />
      <main className="max-w-5xl mx-auto px-4 py-8">
        <div className="flex items-center justify-between mb-8">
          <div>
            <h1 className="text-2xl font-display font-bold tracking-tight">Panel de Administración</h1>
            <p className="text-muted-foreground text-sm mt-1">Gestiona juegos y preguntas</p>
          </div>
          <div className="flex gap-2">
            <Link href="/admin/questions" className="px-4 py-2 rounded-lg border border-border text-sm hover:bg-accent transition-all flex items-center gap-1.5">
              <BookOpen className="w-4 h-4" /> Preguntas
            </Link>
            <button onClick={() => setShowCreate(true)} className="px-4 py-2 rounded-lg bg-primary text-primary-foreground text-sm font-medium hover:bg-primary/90 transition-all flex items-center gap-1.5">
              <Plus className="w-4 h-4" /> Nuevo juego
            </button>
          </div>
        </div>

        {/* Game list */}
        <div className="grid gap-4">
          {(games ?? []).map((game: any, idx: number) => {
            const st = statusLabel(game?.status ?? '');
            return (
              <motion.div key={game?.id ?? idx} initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: idx * 0.03 }}
                className="p-5 rounded-xl bg-card shadow-md hover:shadow-lg transition-all"
              >
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div className="space-y-1">
                    <div className="flex items-center gap-2">
                      <Tag className="w-4 h-4 text-primary" />
                      <span className="font-semibold capitalize">{game?.categoria ?? 'General'}</span>
                      <span className={`text-xs px-2 py-0.5 rounded-full font-medium ${st?.color}`}>{st?.label}</span>
                    </div>
                    <div className="flex items-center gap-4 text-xs text-muted-foreground">
                      <span><DollarSign className="w-3 h-3 inline" /> Bs {game?.costo ?? 0}</span>
                      <span><Users className="w-3 h-3 inline" /> Máx {game?.maxPlayers ?? 0}</span>
                      <span><Trophy className="w-3 h-3 inline" /> {game?.maxWinners ?? 0} ganadores</span>
                    </div>
                  </div>
                  <div className="flex gap-2">
                    <Link href={`/admin/games/${game?.id}`} className="px-3 py-1.5 rounded-lg border border-border text-xs hover:bg-accent transition-all flex items-center gap-1">
                      <Eye className="w-3.5 h-3.5" /> Gestionar
                    </Link>
                    {game?.status === 'waiting' || game?.status === 'finished' && (
                      <button onClick={() => deleteGame(game?.id)} className="px-3 py-1.5 rounded-lg border border-destructive/30 text-xs text-destructive hover:bg-destructive/10 transition-all flex items-center gap-1">
                        <Trash2 className="w-3.5 h-3.5" /> Eliminar
                      </button>
                    )}
                  </div>
                </div>
              </motion.div>
            );
          })}
          {(games?.length ?? 0) === 0 && (
            <div className="text-center py-16">
              <Gamepad2 className="w-12 h-12 text-muted-foreground mx-auto mb-3" />
              <p className="text-muted-foreground">No hay juegos aún. Crea el primero.</p>
            </div>
          )}
        </div>

        {/* Create modal */}
        {showCreate && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
            <motion.div initial={{ scale: 0.9, opacity: 0 }} animate={{ scale: 1, opacity: 1 }} className="bg-card p-6 rounded-xl shadow-xl max-w-md w-full space-y-4">
              <h2 className="text-lg font-display font-bold">Crear nuevo juego</h2>
              {error && <div className="p-2 rounded-lg bg-destructive/10 text-destructive text-sm">{error}</div>}
              <form onSubmit={createGame} className="space-y-3">
                <div className="space-y-1">
                  <label className="text-sm font-medium">Categoría</label>
                  <input type="text" value={form?.categoria ?? ''} onChange={(e) => setForm({ ...form, categoria: e?.target?.value ?? '' })} className="w-full px-3 py-2 rounded-lg border border-input bg-background text-sm" placeholder="Ej: historia, ciencia..." required />
                </div>
                <div className="grid grid-cols-3 gap-3">
                  <div className="space-y-1">
                    <label className="text-xs font-medium">Costo (Bs)</label>
                    <input type="number" value={form?.costo ?? '0'} onChange={(e) => setForm({ ...form, costo: e?.target?.value ?? '0' })} className="w-full px-3 py-2 rounded-lg border border-input bg-background text-sm" min="0" />
                  </div>
                  <div className="space-y-1">
                    <label className="text-xs font-medium">Máx jugadores</label>
                    <input type="number" value={form?.maxPlayers ?? '10'} onChange={(e) => setForm({ ...form, maxPlayers: e?.target?.value ?? '10' })} className="w-full px-3 py-2 rounded-lg border border-input bg-background text-sm" min="2" />
                  </div>
                  <div className="space-y-1">
                    <label className="text-xs font-medium">Ganadores</label>
                    <input type="number" value={form?.maxWinners ?? '3'} onChange={(e) => setForm({ ...form, maxWinners: e?.target?.value ?? '3' })} className="w-full px-3 py-2 rounded-lg border border-input bg-background text-sm" min="1" />
                  </div>
                </div>
                <div className="flex gap-2 pt-2">
                  <button type="submit" disabled={creating} className="flex-1 py-2 rounded-lg bg-primary text-primary-foreground text-sm font-semibold hover:bg-primary/90 disabled:opacity-50">Crear</button>
                  <button type="button" onClick={() => { setShowCreate(false); setError(''); }} className="flex-1 py-2 rounded-lg border border-border text-sm hover:bg-accent">Cancelar</button>
                </div>
              </form>
            </motion.div>
          </div>
        )}
      </main>
    </div>
  );
}
