// app/api/games/[id]/finish/route.ts
import { NextRequest, NextResponse } from 'next/server';
import { prisma } from '@/lib/prisma';
import { getCurrentUser } from '@/lib/auth';

export async function POST(req: NextRequest, { params }: { params: { id: string } }) {
  try {
    const user = await getCurrentUser();
    if (!user || user.role !== 'ADMIN') {
      return NextResponse.json({ error: 'No autorizado' }, { status: 401 });
    }

    const gameId = params.id;
    
    // Verificar que el juego existe y está en progreso
    const game = await prisma.game.findUnique({
      where: { id: gameId }
    });

    if (!game) {
      return NextResponse.json({ error: 'Juego no encontrado' }, { status: 404 });
    }

    if (game.status !== 'in_progress') {
      return NextResponse.json({ error: 'El juego no está en progreso' }, { status: 400 });
    }

    // Actualizar estado a finished
    const updatedGame = await prisma.game.update({
      where: { id: gameId },
      data: { 
        status: 'finished'
        // ❌ NO incluir endedAt porque no existe en el schema
      }
    });

    return NextResponse.json({ 
      success: true, 
      game: updatedGame 
    });

  } catch (error) {
    console.error('Error al finalizar juego:', error);
    return NextResponse.json(
      { error: 'Error al finalizar el juego' },
      { status: 500 }
    );
  }
}
